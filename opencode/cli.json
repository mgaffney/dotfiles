{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system",
    "mode": "system"
  },
  "diffs": {
    "wrap": "word",
    "view": "auto"
  },
  "scroll": {
    "speed": 3,
    "acceleration": true
  },
  "mouse": true,
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.4
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show",
    "markdown": "rendered",
    "grouping": "auto",
    "image_preview": false,
    "permissions": "prompt"
  },
  "animations": true,
  "tabs": {
    "indicators": "numbers"
  },
  "prompt": {
    "image_preview": true
  }
}
